    "descriptions": {
      "peste_negra": {
        "title": "Peste Negra",
        "emoji": "🐀",
        "subtitle": "Você morreu de doença, mas pelo menos foi rápido!",
        "text": "Parabéns! Você foi infectado pela Peste Negra, a doença mais popular da Idade Média. Seus sintomas incluem inchaços horríveis, febre e um cheiro que afasta até os ratos. Pelo menos você não precisou lidar com impostos!"
      },
      "inquiscao": {
        "title": "Inquisição",
        "emoji": "🔥",
        "subtitle": "Queimado na fogueira por heresia",
        "text": "Você foi denunciado por achar que a Terra não é plana ou por ter rido de um padre. Agora, você é o astro principal do espetáculo da Inquisição: a fogueira! Aproveite seu momento de fama enquanto dura."
      },
      "fome": {
        "title": "Fome",
        "emoji": "🍞",
        "subtitle": "Morreu de fome, mas pelo menos tentou comer grama",
        "text": "Você sobreviveu às guerras, às doenças e até à sogra, mas não conseguiu escapar da fome. Parabéns, você é o exemplo perfeito de como a agricultura medieval era uma piada!"
      },
      "guerra": {
        "title": "Guerra",
        "emoji": "⚔️",
        "subtitle": "Morto por um cavaleiro com complexo de herói",
        "text": "Você foi esmagado por um cavaleiro em uma armadura brilhante que nem sabia usar a espada direito. Pelo menos você morreu lutando... ou tentando fugir. Quem sabe?"
      },
      "acidente_bizarro": {
        "title": "Acidente Bizarro",
        "emoji": "💥",
        "subtitle": "Morreu de um jeito que ninguém vai acreditar",
        "text": "Você foi atingido por uma carroça desgovernada, caiu de um castelo enquanto tentava fazer um selfie ou foi atacado por um ganso raivoso. A Idade Média não perdoa ninguém, nem mesmo os desastrados!"
      },
      "bruxaria": {
        "title": "Bruxaria",
        "emoji": "🧙‍♀️",
        "subtitle": "Afogado ou queimado por ser 'diferente'",
        "text": "Você foi acusado de bruxaria porque sabia contar até 10 ou porque tinha um gato preto. Agora, você está nadando no rio ou virando churrasco. Pelo menos você deixou sua marca na história... como um exemplo do que NÃO fazer."
      },
      "overdose_de_cerveja": {
        "title": "Overdose de Cerveja",
        "emoji": "🍺",
        "subtitle": "Morreu bêbado e feliz",
        "text": "Você exagerou na cerveja medieval (que era basicamente pão líquido) e agora está morto. Mas, ei, pelo menos você não teve que lidar com a ressaca!"
      },
      "traicao_nobre": {
        "title": "Traição Nobre",
        "emoji": "👑",
        "subtitle": "Morto por um nobre com inveja do seu charme",
        "text": "Você foi traído por um nobre que não suportava sua popularidade ou sua habilidade de comer 20 pernas de frango em uma sentada. Agora, você é só mais um nome na lista de 'acidentes' reais."
      }
    }
  }