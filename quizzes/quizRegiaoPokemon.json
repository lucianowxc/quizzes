    "descriptions": {
      "kanto": {
        "title": "Kanto",
        "emoji": "🔴",
        "subtitle": "Clássico e Nostálgico",
        "text": "Você pertence a Kanto, onde tudo começou! Você valoriza tradição, gosta de desafios diretos (como derrotar a Liga Pokémon) e tem um coração que bate mais forte ao ouvir a trilha sonora de 8-bits. Cuidado com a Equipe Rocket na esquina!"
      },
      "johto": {
        "title": "Johto",
        "emoji": "🌳",
        "subtitle": "Equilíbrio entre Natureza e História",
        "text": "Johto é seu lar! Você ama mistérios ancestrais (tipo as Torres Gêmeas), adora Pokémon que evoluem com amizade e curte uma xícara de chá no Celebi Café. Só não se perca no Bosque de Ilex!"
      },
      "hoenn": {
        "title": "Hoenn",
        "emoji": "🌊",
        "subtitle": "Aventura em Alto-Mar",
        "text": "Você foi destinado a Hoenn! Entre vulcões fumegantes, mergulhos em cavernas subaquáticas e a eterna briga entre Terra e Mar, você está pronto para surfar nas ondas com seu Mega Blaziken. #MeteoroDeSootopolis"
      },
      "sinnoh": {
        "title": "Sinnoh",
        "emoji": "⛰️",
        "subtitle": "Filósofo das Montanhas",
        "text": "Sinnoh é seu refúgio! Você adora debates sobre tempo, espaço e mitologia, escala o Monte Coronet por diversão e acha que Giratina só precisa de um abraço. Atenção: lake guardians podem stalkear você."
      },
      "unova": {
        "title": "Unova",
        "emoji": "🌆",
        "subtitle": "Urbanista Idealista",
        "text": "Unova combina com você! Entre arranha-céus, musicais de Pokémon e debates sobre ‘Verdade vs. Ideal’, você está sempre pronto para um hambúrguer no Casteliacone ou uma revolução (pacífica, claro)."
      },
      "kalos": {
        "title": "Kalos",
        "emoji": "💎",
        "subtitle": "Elegância e Megaevolução",
        "text": "Kalos é seu estilo! Você brilha em batalhas de Mega Evolução, ama fotossíntese (tipo a Floresta de Santalune) e acha que tudo fica melhor com um toque francês. Team Flare? Jamais, seu visual é impecável!"
      },
      "alola": {
        "title": "Alola",
        "emoji": "🌺",
        "subtitle": "Vibe Tropical e ‘Island Scan’",
        "text": "Alola, campeão! Sua vida é praia, trial captains, shaved ice e dançar com Oricorios. Você ignora os Ultra Beasts e diz que o verdadeiro perigo é o Sol escaldante. Malasada > tudo."
      },
      "galar": {
        "title": "Galar",
        "emoji": "🏰",
        "subtitle": "Esporte e Chá com Scones",
        "text": "Galar é seu estádio! Você acorda pronto para o Gym Challenge, acha que Dynamax é a melhor invenção desde pão fatiado e defende que Chairman Rose… bem, tinha boas intenções? #CupNoodlesForever"
      },
      "paldea": {
        "title": "Paldea",
        "emoji": "🍊",
        "subtitle": "Liberdade e Caos Acadêmico",
        "text": "Você nasceu para Paldea! Entre Treasure Hunts, aulas de Biologia com a Sra. Jacq e sanduíches que desafiam as leis da física, você prova que o verdadeiro tesouro são os amigos (e os Paradox Pokémon)."
      },
      "hisui": {
        "title": "Hisui",
        "emoji": "🎴",
        "subtitle": "Pioneiro do Passado",
