  "descriptions": {
    "sujeito": {
      "title": "Sujeito",
      "emoji": "🧑‍🏫",
      "subtitle": "O protagonista da oração",
      "text": "Você é quem realiza a ação ou sobre quem se diz algo. Sem você, a frase ficaria sem um propósito claro!"
    },
    "verbo_transitivo_direto": {
      "title": "Verbo Transitivo Direto",
      "emoji": "⚡",
      "subtitle": "O motor da oração",
      "text": "Você é a palavra que exprime ação e precisa de um complemento direto para completar o sentido. Sem você, a frase ficaria incompleta!"
    },
    "verbo_transitivo_indireto": {
      "title": "Verbo Transitivo Indireto",
      "emoji": "🎢",
      "subtitle": "O mediador da ação",
      "text": "Você é a palavra que exprime ação e precisa de um complemento indireto, geralmente introduzido por preposição. Sem você, a frase não estaria completamente clara!"
    },
    "objeto_direto": {
      "title": "Objeto Direto",
      "emoji": "🎯",
      "subtitle": "O alvo da ação",
      "text": "Você recebe diretamente a ação do verbo. Sem você, algumas orações ficariam incompletas!"
    },
    "objeto_indireto": {
      "title": "Objeto Indireto",
      "emoji": "📨",
      "subtitle": "O destinatário da ação",
      "text": "Você é quem recebe a ação do verbo indiretamente, normalmente precedido por uma preposição. Sem você, algumas frases perderiam seu sentido completo!"
    },
    "aposto": {
      "title": "Aposto",
      "emoji": "📌",
      "subtitle": "O explicador da sentença",
      "text": "Você é o termo que explica, amplia ou esclarece outro termo na frase. Sua função é tornar tudo mais claro e detalhado!"
    },
    "vocativo": {
      "title": "Vocativo",
      "emoji": "🗣️",
      "subtitle": "O chamador de atenção",
      "text": "Você é o termo utilizado para chamar, invocar ou nomear o interlocutor. Sua presença destaca a interação e comunicação direta!"
    },
    "verbo_intransitivo": {
      "title": "Verbo Intransitivo",
      "emoji": "🚀",
      "subtitle": "O autossuficiente",
      "text": "Você é um verbo que não precisa de complemento para fazer sentido. Sua ação é completa por si só, direta e impactante!"
    },
    "verbo_de_ligação": {
      "title": "Verbo de Ligação",
      "emoji": "🔗",
      "subtitle": "O conector de estados",
      "text": "Você é o verbo que liga o sujeito a uma característica ou estado. Sem você, as qualidades e estados dos sujeitos não seriam revelados!"
    }
  }
