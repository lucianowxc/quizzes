      },
      "Chumbo": {
        "title": "Chumbo (Pb) 🧠",
        "emoji": "🧠",
        "subtitle": "O Tóxico Nostálgico",
        "text": "Você é o Chumbo! Pesado, tóxico e obsoleto. Já foi útil em gasolina, mas hoje só causa dor de cabeça."
      },
