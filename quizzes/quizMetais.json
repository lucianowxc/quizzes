      },
      "Death Metal": {
        "title": "Death Metal 💀",
        "emoji": "💀",
        "subtitle": "O Extremo Gritador",
        "text": "Você é o Death Metal! Grita, growla e assusta os vizinhos. Seu hobby? Colecionar caveiras e desespero."
      },
      "Metalcore": {
        "title": "Metalcore 🎸",
        "emoji": "🎸",
        "subtitle": "O Adolescente Revoltado",
